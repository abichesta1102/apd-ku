# =============================================================
#  TEMPLATE KONFIGURASI SISTEM DETEKSI APD
#  Salin file ini menjadi '.env' lalu isi nilainya.
#  File '.env' JANGAN di-commit ke Git!
# =============================================================

# --- Discord ---
# URL webhook dari channel Discord Anda (Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# --- Direktori & Lokasi ---
# Folder berisi foto-foto referensi wajah pegawai
FOTO_PEGAWAI_DIR=foto_pegawai
# Nama lokasi yang akan muncul di laporan Discord
LOKASI_RUANGAN=Ruangan Genset
# Path file model YOLOv8 PPE
YOLO_MODEL_PATH=ppe_best.pt

# --- Kamera ---
# Index kamera (0 = kamera pertama, 1 = kamera kedua, dst.)
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
# Proses deteksi setiap N frame (lebih besar = lebih ringan tapi lebih lambat respons)
FRAME_SKIP=3

# --- Pengenalan Wajah ---
# Model DeepFace: SFace, VGG-Face, ArcFace, Facenet, dll.
FACE_MODEL_NAME=SFace
# Backend detektor wajah: retinaface, opencv, mtcnn, ssd, mediapipe
FACE_DETECTOR_BACKEND=retinaface
# Ukuran minimum crop kepala (piksel) agar identifikasi dijalankan
MIN_CROP_SIZE=40
# Set 'true' untuk paksa rebuild database wajah dari awal (lalu kembalikan ke 'false')
FORCE_REBUILD_FACE_DB=false

# --- Alert ---
# Jeda minimum (detik) antara dua laporan untuk orang yang sama
COOLDOWN_SECONDS=15
